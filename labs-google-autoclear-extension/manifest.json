{
  "manifest_version": 3,
  "name": "Google Flow Auto-Clear Fail & Countdown",
  "version": "1.0.0",
  "description": "ตรวจจับ Fail ชั่วคราวบน flow.google.com แล้วล้างแคช คุกกี้ และรีเฟรชให้อัตโนมัติทันที",
  "permissions": [
    "storage",
    "cookies",
    "browsingData",
    "tabs"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
