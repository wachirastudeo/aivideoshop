{
  "manifest_version": 3,
  "name": "Labs.google Activity Monitor",
  "version": "1.0.0",
  "description": "ตรวจจับข้อผิดพลาดบน labs.google และแจ้งเตือนโดยไม่ส่งคำขอซ้ำอัตโนมัติ",
  "permissions": [
    "storage",
    "browsingData",
    "tabs"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://labs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*", "https://labs.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
